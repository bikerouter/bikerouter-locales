{
    "about": {
        "hosted": "Bikerouter is hosted by <a href='https://marcusjaschen.com/' target='_blank'>Marcus Jaschen</a>. Contact: <a href='https://en.osm.town/@bikerouter' target='_blank' rel='me'>@bikerouter@en.osm.town</a>",
        "imprint": "Imprint",
        "introduction": "Bikerouter is the perfect way to plan bike routes online and is based on BRouter-Web. <b>BRouter-Web is a project by Norbert Renner,</b> the routing engine <b>BRouter was developed by Arndt Brenschede.</b>",
        "language-switch-reload": "(Seite lädt neu)",
        "license": "Licenses and further information",
        "link-manual-de": "Handbuch 🇩🇪",
        "link-manual-en": "Manual 🇬🇧",
        "manual": "The manual for Bikerouter is work in progress and is being created here:",
        "privacy": "Privacy",
        "routing-data": "The routing data is generated directly from <a href=\"https://www.openstreetmap.org\" target=\"_blank\">OpenStreetMap</a> about four to five times every day. The data age can be seen on the timestamp of the <a href=\"https://brouter.m11n.de/segments/\" target=\"_blank\">data files</a>. (Timestamp in UTC).",
        "support": "<strong>Do you have questions</strong> that are not yet answered by the manual and the articles linked on the manual homepage? In the <a href=\"https://www.mtb-news.de/forum/f/gps-geraete-gps-software-karten-und-routenplanung.173/\" rel=\"nofollow\" target=\"_blank\">bikerouter.de support forum</a> at MTB-News.de you will definitely get help (alas, in German only). <small><mark>Please understand that I can no longer answer support requests by email – the time required has unfortunately become too much.</mark></small>",
        "title": "About Bikerouter",
        "title-routing-data": "Routing Data",
        "tooltip": "Show more information about Bikerouter"
    },
    "about-local-profiles": {
        "title": "Custom Routing Profiles",
        "helptext1": "You can save your customizations to routing profiles directly in your browser and also load them from there. No longer needed custom profiles can also be deleted.",
        "helptext2": "These customizations are only visible for you and in the currently used browser and not for other users.",
        "helptext3": "If you want to use your custom profiles on other devices, you should save them on your computer. This way you also have a backup in case you reset your browser.",
        "helptext4": "To transfer custom profiles to another computer, use the settings export feature to download all important Bikerouter settings, including your custom profiles. On the new computer, import the downloaded file using the import settings feature. Export and import buttons are located in the main dropdown menu."
    },
